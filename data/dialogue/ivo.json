    "caravan": {
      "text": "\"Two days north of here, a man calling himself Redmaw Kessler relieved me of three sealed crates and my professional dignity. The crates matter - a season's stock, paid in advance. Bring them back and Bramblewick gets a proper shop, with my gratitude priced into everything.\"",
      "choices": [
        {
          "label": "I'll walk the North Road and get your crates. (Accept quest)",
          "events": [
            {
              "type": "start_quest",
              "quest": "q_lost_caravan"
            }
          ],
          "next": "start"
        },
        {
          "label": "Bandits are your problem, peddler.",
          "next": "start"
        }
      ]
    },
    "restored": {
      "text": "He breaks a seal, looks inside, and for a moment can't speak. \"Seasons of work. You've bought a village its shop, friend - and yourself the good prices. Look at THESE wares.\"",
      "choices": [
        {
          "label": "(Look at the wares)",
          "next": "start"
